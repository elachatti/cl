# ---------- Application ----------
APP_NAME="AI Career Companion API"
APP_ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---------- MySQL ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=ai_career_companion
# Optional: full SQLAlchemy URL that overrides the MYSQL_* values
# DATABASE_URL=
DB_ECHO=false
AUTO_CREATE_TABLES=true

# ---------- JWT ----------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-this-with-a-long-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REMEMBER_ME_EXPIRE_DAYS=30
EMAIL_VERIFY_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=30
BCRYPT_ROUNDS=12

# ---------- Auth behaviour ----------
REQUIRE_EMAIL_VERIFICATION=true

# ---------- Email (leave SMTP_HOST empty to print emails in the console) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM="AI Career Companion <no-reply@aicareercompanion.local>"

# ---------- First admin (created automatically on startup if both are set) ----------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123
ADMIN_FULL_NAME=Platform Admin

# ---------- Event image uploads ----------
UPLOAD_DIR=static/uploads/events
STATIC_URL_PREFIX=/static
MAX_IMAGE_SIZE_MB=5
